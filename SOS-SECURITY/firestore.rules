rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        // =========================================
        // USERS
        // =========================================

        match /users/{userId} {

            allow read:
                if request.auth != null;

            allow create:
                if request.auth != null
                && request.auth.uid == userId;

            allow update:
                if request.auth != null
                && request.auth.uid == userId;

            allow delete:
                if request.auth != null
                && request.auth.uid == userId;
        }


        // =========================================
        // CONNECTION REQUESTS
        // =========================================

        match /connection_requests/{requestId} {

            allow create:
                if request.auth != null
                && request.resource.data.fromUid
                   == request.auth.uid;


            allow read:
                if request.auth != null
                &&
                (
                    resource.data.fromUid
                    == request.auth.uid

                    ||

                    resource.data.toUid
                    == request.auth.uid
                );


            allow update:
                if request.auth != null
                &&
                resource.data.toUid
                == request.auth.uid;
        }


        // =========================================
        // TRUSTED PEOPLE
        // =========================================

        match /trusted_people/{relationshipId} {

            allow read:
                if request.auth != null
                &&
                resource.data.ownerUid
                == request.auth.uid;

            allow create:
                if request.auth != null
                &&
                request.resource.data.ownerUid
                == request.auth.uid;

            allow delete:
                if request.auth != null
                &&
                resource.data.ownerUid
                == request.auth.uid;
        }


        // =========================================
        // SOS
        // =========================================

        match /sos_alerts/{alertId} {

            allow create:
                if request.auth != null
                &&
                request.resource.data.userId
                == request.auth.uid;


            allow read:
                if request.auth != null
                &&
                resource.data.userId
                == request.auth.uid;

        }


    }

}